@model List<HR_MVC_ITI.Models.ViewModels.AttendanceViewModel>

@{
    ViewData["Title"] = "My Attendance";
    var employeeName = ViewBag.EmployeeName as string ?? "Employee";
    var employeeId = (int)(ViewBag.EmployeeId ?? 0);
    bool hasOpenCheckIn = ViewBag.HasOpenCheckIn ?? false;
    bool alreadyCheckedIn = ViewBag.AlreadyCheckedIn ?? false;
}

<h1 class="mt-4">My Attendance</h1>
<ol class="breadcrumb mb-4">
    <li class="breadcrumb-item active">Welcome, @employeeName</li>
</ol>

<!-- Check In / Check Out Buttons -->
<div class="card mb-4">
    <div class="card-header">
        <i class="fas fa-clock me-1"></i>Today's Actions
    </div>
    <div class="card-body d-flex gap-3">
        @if (!alreadyCheckedIn)
        {
            <a asp-action="MyCheckIn" class="btn btn-success btn-lg">
                <i class="fas fa-sign-in-alt me-2"></i>Check In
            </a>
        }
        else if (hasOpenCheckIn)
        {
            <span class="btn btn-secondary btn-lg disabled">
                <i class="fas fa-check me-2"></i>Already Checked In ✓
            </span>
            <a asp-action="MyCheckOut" class="btn btn-warning btn-lg">
                <i class="fas fa-sign-out-alt me-2"></i>Check Out
            </a>
        }
        else
        {
            <span class="btn btn-secondary btn-lg disabled">
                <i class="fas fa-check-double me-2"></i>Done for today ✓
            </span>
        }
    </div>
</div>

<!-- Attendance History -->
<div class="card mb-4">
    <div class="card-header">
        <i class="fas fa-calendar-check me-1"></i>My Attendance History
    </div>
    <div class="card-body">
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Check In</th>
                    <th>Check Out</th>
                    <th>Late</th>
                    <th>Overtime</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var attendance in Model)
                    {
                        <tr>
                            <td>@attendance.Date.ToString("yyyy-MM-dd")</td>
                            <td>@(attendance.CheckInTime?.ToString("hh:mm tt") ?? "-")</td>
                            <td>@(attendance.CheckOutTime?.ToString("hh:mm tt") ?? "-")</td>
                            <td>
                                @if (attendance.LateMinutes > 0)
                                {
                                    <span class="badge bg-danger">@attendance.LateMinutes min</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">On Time</span>
                                }
                            </td>
                            <td>
                                @if (attendance.OvertimeHours > 0)
                                {
                                    <span class="badge bg-info">@attendance.OvertimeHours.ToString("F1") hrs</span>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center">No attendance records yet.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
