@model IEnumerable<HR_MVC_ITI.Models.ViewModels.PayrollViewModel>

@{
    ViewData["Title"] = "Payroll";
}

<h1>Payroll</h1>

<p>
    <a asp-action="Add" class="btn btn-primary">Add new Payroll</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Employee Name</th>
            <th>Month</th>
            <th>Year</th>
            <th>Basic Salary</th>
            <th>Late Deductions</th>
            <th>Overtime Additions</th>
            <th>Net Salary</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var payroll in Model)
        {
            <tr>
                <td>@payroll.Id</td>
                <td>@payroll.EmployeeName</td>
                <td>@payroll.Month</td>
                <td>@payroll.Year</td>
                <td>@payroll.BasicSalary</td>
                <td>@payroll.LateDeductions</td>
                <td>@payroll.OvertimeAdditions</td>
                <td>@payroll.NetSalary</td>
                <td>
                    <a asp-action="Update" asp-route-id="@payroll.Id">Update</a> |
                    <a asp-action="Delete" asp-route-id="@payroll.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
