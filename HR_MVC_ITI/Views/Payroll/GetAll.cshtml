<h1>The information of Payroll</h1>
<a href="/Payroll/Add">Add new Payroll</a>
<table border="10" style="width:100%;border-collapse:collapse;font-size:.95rem;background-color:#ffffff">
    <tr>
        <th>Id</th>
        <th>Employee Name</th>
        <th>Month</th>
        <th>Year</th>
        <th>BasicSalary</th>
        <th>LateDeductions</th>
        <th>OvertimeAdditions</th>
    </tr>
    @foreach (var payroll in Model)
    {
        <tr>
            <td>@payroll.Id</td>
            <td>@payroll.Employee.EmployeeName</td>
            <td>@payroll.Month</td>
            <td>@payroll.Year</td>
            <td>@payroll.BasicSalary</td>
            <td>@payroll.LateDeductions</td>
            <td>@payroll.OvertimeAdditions</td>
            <td><a href="/Payroll/Update/@payroll.Id">Update</a></td>
            <td><a href="/Payroll/Delete/@payroll.Id">Delete</a></td>

        </tr>
    }
</table>