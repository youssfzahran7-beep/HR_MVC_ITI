@model HR_MVC_ITI.ViewModels.OfferViewModel

@{
    ViewData["Title"] = " Create";
}

<div class="container mt-4">
    <h2>  Create new offer</h2>
    <form asp-action="Create" method="post">
        <div class="mb-3">
            <label asp-for="ApplicationProcessId" class="form-label"></label>
            <input asp-for="ApplicationProcessId" class="form-control" type="number" />
            <span asp-validation-for="ApplicationProcessId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="BasicSalaryOffer" class="form-label"></label>
            <input asp-for="BasicSalaryOffer" class="form-control" type="number" step="0.01" />
            <span asp-validation-for="BasicSalaryOffer" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-success"> Save</button>
        <a asp-action="Index" class="btn btn-secondary">Exit</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}