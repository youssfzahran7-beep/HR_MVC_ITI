@model HR_MVC_ITI.ViewModels.OfferViewModel

@{
    ViewData["Title"] = "Edit Offer";
}

<div class="container mt-4">
    <h2>Edit Offer #@Model.Id</h2>

    <form asp-action="Edit" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="ApplicationProcessId" class="form-label">Application Process (Candidate):</label>
            <select asp-for="ApplicationProcessId" asp-items="ViewBag.ApplicationProcesses" class="form-select">
                <option value="">-- Select Application Process --</option>
            </select>
            <span asp-validation-for="ApplicationProcessId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="InterviewId" class="form-label">Related Interview (Optional):</label>
            <select asp-for="InterviewId" asp-items="ViewBag.Interviews" class="form-select">
                <option value="">-- Select Interview (Optional) --</option>
            </select>
            <span asp-validation-for="InterviewId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="BasicSalaryOffer" class="form-label">Basic Salary Offer:</label>
            <input asp-for="BasicSalaryOffer" class="form-control" type="number" step="0.01" />
            <span asp-validation-for="BasicSalaryOffer" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Status" class="form-label">Offer Status:</label>
            <select asp-for="Status" asp-items="Html.GetEnumSelectList<HR_MVC_ITI.Models.Enumes.OfferStatus>()" class="form-select"></select>
            <span asp-validation-for="Status" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-warning">Update Offer</button>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}