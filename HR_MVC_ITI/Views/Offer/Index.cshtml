@model IEnumerable<HR_MVC_ITI.ViewModels.OfferViewModel>

@{
    ViewData["Title"] = "List Offer";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2> List Offer</h2>
        <a asp-action="Create" class="btn btn-primary">Create</a>
    </div>

    <table class="table table-bordered table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Id:</th>
                <th>IdEmployee: </th>
                <th>Salary:</th>
                <th>Status:</th>
                <th>Operation:</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.ApplicationProcessId</td>
                    <td>@item.BasicSalaryOffer.ToString("C")</td>
                    <td>
                        <span class="badge @(item.Status == HR_MVC_ITI.Models.Enumes.OfferStatus.Accepted ? "bg-success" :
                       item.Status== HR_MVC_ITI.Models.Enumes.OfferStatus.Rejected ? "bg-danger" : "bg-warning text-dark")">
                            @item.Status
                        </span>
                    </td>
                    <td>
                        <div class="d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>