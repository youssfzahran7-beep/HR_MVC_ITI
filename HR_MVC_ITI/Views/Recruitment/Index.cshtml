@model IEnumerable<HR_MVC_ITI.DTOs.RecruitmentDTO>

@{
    ViewData["Title"] = "Recruitment";
}

<div class="container-fluid px-4">

    <div class="d-flex justify-content-between align-items-center mt-4 mb-4">
        <div>
            <h1 class="mb-1">Recruitment</h1>
            <p class="text-muted mb-0">Manage job postings</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i>
            Add New Job
        </a>
    </div>

    <div class="card mb-4">

        <div class="card-header">
            <i class="fas fa-briefcase me-1"></i>
            Job Postings
        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Description</th>
                            <th>Status</th>
                            <th>Created At</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            @foreach (var recruitment in Model)
                            {
                                <tr>

                                    <td>
                                        <strong>@recruitment.Title</strong>
                                    </td>

                                    <td>
                                        @recruitment.Description
                                    </td>

                                    <td>
                                        @if (recruitment.Status == "Open")
                                        {
                                            <span class="badge bg-success">
                                                Open
                                            </span>
                                        }
                                        else if (recruitment.Status == "Paused")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Paused
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Closed
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @recruitment.CreatedAt.ToShortDateString()
                                    </td>

                                    <td>
                                        <div class="d-flex gap-1">

                                            <a asp-action="Details"
                                               asp-route-id="@recruitment.Id"
                                               class="btn btn-sm btn-info">
                                                Details
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@recruitment.Id"
                                               class="btn btn-sm btn-warning">
                                                Edit
                                            </a>

                                            <form asp-action="Delete"
                                                  asp-route-id="@recruitment.Id"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-danger"
                                                        onclick="return confirm('Are you sure you want to delete this job posting?');">
                                                    Delete
                                                </button>

                                            </form>

                                        </div>
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5"
                                    class="text-center text-muted py-4">
                                    No job postings found.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>
