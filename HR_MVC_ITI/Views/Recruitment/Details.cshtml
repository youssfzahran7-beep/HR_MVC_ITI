@model HR_MVC_ITI.Models.ViewModels.RecruitmentViewModel

@{
    ViewData["Title"] = "Job Details";
}

<div class="container-fluid px-4">

    <div class="d-flex justify-content-between align-items-center mt-4 mb-4">

        <div>
            <h1 class="mb-1">Job Details</h1>
            <p class="text-muted mb-0">
                View job posting information
            </p>
        </div>

        <div>
            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-warning">
                <i class="fas fa-edit me-1"></i>
                Edit
            </a>

            <a asp-action="Index"
               class="btn btn-secondary">
                Back
            </a>
        </div>

    </div>


    <div class="card mb-4">

        <div class="card-header">
            <i class="fas fa-briefcase me-1"></i>
            @Model.Title
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-8">

                    <h5>Description</h5>

                    <p class="text-muted">
                        @Model.Description
                    </p>

                    <hr />

                    <h5>Requirements</h5>

                    <p class="text-muted">
                        @Model.Requirements
                    </p>

                </div>


                <div class="col-md-4">

                    <div class="card bg-light">

                        <div class="card-body">

                            <h6 class="text-muted">
                                Job Information
                            </h6>

                            <hr />

                            <p>
                                <strong>Job ID:</strong>
                                @Model.Id.ToString()</p>
                            <p> <strong>Status:</strong>@if (Model.Status.ToString() == "Open")
                                { <span class="badge bg-success">
                 Open
                                    </span>
                                }
                                else if (Model.Status.ToString() == "Paused")
                                {
                                    <span class="badge bg-warning text-dark">
                                        Paused
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Closed
                                    </span>
                                }
                            </p>

                            <p>
                                <strong>Created At:</strong>
                                @Model.CreatedAt.ToShortDateString()
                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
