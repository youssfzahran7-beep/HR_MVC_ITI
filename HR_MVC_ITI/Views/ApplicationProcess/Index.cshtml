@model IEnumerable<HR_MVC_ITI.Models.ViewModels.ApplicationProcessViewModel>
@{
    ViewData["Title"] = "Application Process";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mt-4">Application Pipeline</h1>
        <p class="text-muted">
            Track candidate applications through the recruitment process.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i>
        New Application
    </a>
</div>

<div class="card mb-4">

    <div class="card-header">
        <i class="fas fa-tasks me-1"></i>
        Active Applications
    </div>

    <div class="card-body">

        <div class="table-responsive">

            <table class="table table-bordered table-hover">

                <thead>
                    <tr>
                        <th>Candidate</th>
                        <th>Job</th>
                        <th>Applied Date</th>
                        <th>Current Stage</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null)
                    {
                        foreach (var application in Model)
                        {
                            <tr>

                                <!-- Candidate -->
                                <td>
                                    @application.CandidateName
                                </td>

                                <!-- Recruitment / Job -->
                                <td>
                                    @application.RequirementTitle
                                </td>

                             
                                <td>
                                    @application.AppliedDate.ToString("dd/MM/yyyy")
                                </td>

                                <!-- Current Stage + Update Stage -->
                                <td>

                                    <div class="mb-2">

                                        @switch (application.CurrentStage)
                                        {
                                            case HR_MVC_ITI.Models.Enumes.ApplicationStage.Applied:
                                                <span class="badge bg-primary">
                                                    Applied
                                                </span>
                                                break;

                                            case HR_MVC_ITI.Models.Enumes.ApplicationStage.Interviewing:
                                                <span class="badge bg-warning text-dark">
                                                    Interviewing
                                                </span>
                                                break;

                                            case HR_MVC_ITI.Models.Enumes.ApplicationStage.Offered:
                                                <span class="badge bg-info text-dark">
                                                    Offered
                                                </span>
                                                break;

                                            case HR_MVC_ITI.Models.Enumes.ApplicationStage.Hired:
                                                <span class="badge bg-success">
                                                    Hired
                                                </span>
                                                break;

                                            case HR_MVC_ITI.Models.Enumes.ApplicationStage.Rejected:
                                                <span class="badge bg-danger">
                                                    Rejected
                                                </span>
                                                break;
                                        }

                                    </div>

                                    <form asp-action="Edit"
                                          method="post"
                                          class="d-flex gap-2">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="Id"
                                               value="@application.Id" />

                                        <input type="hidden"
                                               name="CandidateId"
                                               value="@application.CandidateId" />

                                        <input type="hidden"
                                               name="RecruitmentId"
                                               value="@application.RecruitmentId" />

                                        <input type="hidden"
                                               name="AppliedDate"
                                               value="@application.AppliedDate" />

                                        <select name="CurrentStage"
                                                class="form-select form-select-sm">

                                            @foreach (var stage in Enum.GetValues<HR_MVC_ITI.Models.Enumes.ApplicationStage>())
                                            {
                                                if (application.CurrentStage == stage)
                                                {
                                                    <option value="@stage" selected>
                                                        @stage
                                                    </option>
                                                }
                                                else
                                                {
                                                    <option value="@stage">
                                                        @stage
                                                    </option>
                                                }
                                            }

                                        </select>

                                        <button type="submit"
                                                class="btn btn-sm btn-primary">
                                            Update
                                        </button>

                                    </form>

                                </td>

                                <!-- Actions -->
                                <td>

                                    <!-- Details -->
                                    <a asp-action="Details"
                                       asp-route-id="@application.Id"
                                       class="btn btn-sm btn-info">

                                        <i class="fas fa-eye me-1"></i>
                                        Details

                                    </a>

                                    <!-- Cancel / Delete -->
                                    <form asp-action="Delete"
                                          asp-route-id="@application.Id"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Are you sure you want to remove this application?');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-danger">

                                            <i class="fas fa-times me-1"></i>
                                            Cancel

                                        </button>

                                    </form>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>
