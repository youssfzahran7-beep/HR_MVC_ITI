@model HR_MVC_ITI.DTOs.ApplicationProcessDTO
@{
    ViewData["Title"] = "Apply for Job";
}

<h1 class="mt-4">Apply for Job</h1>

<div class="card mb-4">

    <div class="card-header">
        <i class="fas fa-paper-plane me-1"></i>
        Job Application
    </div>

    <div class="card-body">

        <form asp-action="Create" method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>


            <div class="mb-3">

                <label asp-for="CandidateId"
                       class="form-label">
                    Candidate
                </label>

                <input asp-for="CandidateId"
                       class="form-control" />

                <span asp-validation-for="CandidateId"
                      class="text-danger">
                </span>

            </div>


            <div class="mb-3">

                <label asp-for="RecruitmentId"
                       class="form-label">
                    Job
                </label>

                <input asp-for="RecruitmentId"
                       class="form-control" />

                <span asp-validation-for="RecruitmentId"
                      class="text-danger">
                </span>

            </div>


            <div class="alert alert-info">

                <i class="fas fa-info-circle me-1"></i>

                Your application will automatically be submitted
                with the stage <strong>Applied</strong> and the current date.

            </div>


            <button type="submit"
                    class="btn btn-primary">

                <i class="fas fa-paper-plane me-1"></i>
                Submit Application

            </button>

            <a asp-action="Index"
               class="btn btn-secondary">

                Cancel

            </a>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
