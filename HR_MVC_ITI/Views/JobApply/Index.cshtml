@model HR_MVC_ITI.Models.ViewModels.JobApplyViewModel
<h1>Job Apply</h1>
<form method="post" enctype="multipart/form-data" class="card card-body">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <label>Requirement</label><select asp-for="RecruitmentId" asp-items="ViewBag.Requirements" class="form-select"><option value="">-- Select requirement --</option></select>
    <label asp-for="FirstName"></label><input asp-for="FirstName" class="form-control" />
    <label asp-for="LastName"></label><input asp-for="LastName" class="form-control" />
    <label asp-for="Phone"></label><input asp-for="Phone" class="form-control" />
    <label asp-for="Resume">CV file</label><input asp-for="Resume" type="file" accept=".pdf,.doc,.docx" class="form-control" />
    <span asp-validation-for="Resume" class="text-danger"></span><button class="btn btn-primary mt-3">Submit application</button>
</form>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
