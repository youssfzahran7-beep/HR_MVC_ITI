@model IEnumerable<HR_MVC_ITI.Models.Enitityes.Contract>
@{
    ViewData["Title"] = "Contracts";
}
<h2>Contract List</h2>
<p>
    <a asp-action="Create" class="btn btn-primary">Create New Contract</a>
</p>
<table class="table table-striped table-borderless">
    <thead>
        <tr>
            <th>Employee ID:</th>
            <th>Basic Salary:</th>
            <th>Start Date:</th>
            <th>End Date:</th>
            <th>Status:</th>
            <th>Actions:</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.EmployeeId</td>
                    <td>@item.BasicSalary</td>
                    <td>@item.StartDate</td>
                    <td>@item.EndDate</td>
                    <td>@item.Status</td>
                    <td>
                        <a asp-action="Edit" asp-controller="@item.Id" class="btn btn-info">Edit</a>
                        <a asp-action="Details" asp-controller="@item.Id" class="btn btn-info">Details</a>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" 
                        style="display:inline" onsubmit="Return Confirm('Are you Sure your Delete?')">
                            <button type="submit" class="btn bt">Delete</button>
                          </form>
                          </td>
                </tr>
            }

        }
        else
        {
            <tr>
                <td colspan="6" class="text-Center"> No Contract Available.</td>
            </tr>
        }
    </tbody>
                        </table>