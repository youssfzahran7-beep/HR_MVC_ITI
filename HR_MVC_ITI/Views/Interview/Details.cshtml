@model HR_MVC_ITI.ViewModels.InterviewViewModel

@{
    ViewData["Title"] = "Details Interview";
}

<div class="container mt-4">
    <div class="card">
        <div class="card-header bg-info text-white">
            <h4>Details : </h4>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Name :</dt>
                <dd class="col-sm-9">@Model.ApplicantionName</dd>

                <dt class="col-sm-3">Date :</dt>
                <dd class="col-sm-9">@Model.InterviewDate</dd>

                <dt class="col-sm-3">FeedBack:</dt>
                <dd class="col-sm-9">@Model.FeedBack</dd>
            </dl>
        </div>
        <div class="card-footer">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Details</a>
            <a asp-action="Index" class="btn btn-secondary">Back </a>
        </div>
    </div>
</div>