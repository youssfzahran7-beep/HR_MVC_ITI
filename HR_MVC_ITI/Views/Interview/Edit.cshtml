@model HR_MVC_ITI.ViewModels.InterviewViewModel

@{
    ViewData["Title"] = "Edit Interview";
}

<div class="container mt-4">
    <h2>Edit Interview</h2>

    <form asp-action="Edit" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="ApplicationProcessId" class="form-label">Application Process (Candidate):</label>
            <select asp-for="ApplicationProcessId" asp-items="ViewBag.ApplicationProcesses" class="form-select">
                <option value="">-- Select Application Process --</option>
            </select>
            <span asp-validation-for="ApplicationProcessId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="InterviewDate" class="form-label">Date & Time:</label>
            <input asp-for="InterviewDate" class="form-control" type="datetime-local" />
            <span asp-validation-for="InterviewDate" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="InterviewerID" class="form-label">Interviewer ID / Name:</label>
            <input asp-for="InterviewerID" class="form-control" />
            <span asp-validation-for="InterviewerID" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Score" class="form-label">Score (0 - 100):</label>
            <input asp-for="Score" class="form-control" type="number" step="0.1" min="0" max="100" />
            <span asp-validation-for="Score" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="FeedBack" class="form-label">Feedback:</label>
            <textarea asp-for="FeedBack" class="form-control" rows="3"></textarea>
            <span asp-validation-for="FeedBack" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Update</button>
        <a asp-action="Index" class="btn btn-secondary">Back</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
