@model HR_MVC_ITI.Models.Enitityes.Employee

@{
    ViewData["Title"] = "Delete employee";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-danger shadow-sm mt-4">
            <div class="card-header bg-danger text-white">
                <h1 class="h5 mb-0"><i class="fas fa-triangle-exclamation me-2"></i>Delete employee</h1>
            </div>
            <div class="card-body p-4">
                <p class="mb-4">Are you sure you want to delete <strong>@Model.FullName</strong>? This action cannot be undone.</p>
                <dl class="row small mb-4">
                    <dt class="col-sm-4 text-muted">National ID</dt>
                    <dd class="col-sm-8">@Model.NationalId</dd>
                    <dt class="col-sm-4 text-muted">User account</dt>
                    <dd class="col-sm-8 font-monospace">@Model.UserId</dd>
                </dl>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex justify-content-end gap-2">
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-danger"><i class="fas fa-trash me-2"></i>Delete employee</button>
                </form>
            </div>
        </div>
    </div>
</div>
