@model HR_MVC_ITI.Models.ViewModels.EmployeeViewModel

@{
    ViewData["Title"] = "Add New Employee";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-lg border-0 rounded-lg mt-4">
            <div class="card-header bg-primary text-white">
                <h3 class="text-center font-weight-light my-2">Add New Employee</h3>
            </div>
            <div class="card-body p-4">
                <form asp-controller="Employee" asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="FullName" class="form-control" placeholder="Full Name" />
                        <label asp-for="FullName"></label>
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="NationalId" class="form-control" placeholder="National ID" />
                        <label asp-for="NationalId"></label>
                        <span asp-validation-for="NationalId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="UserId" class="form-label text-muted ms-1">Select User Account (Created via AddUser)</label>
                        <select asp-for="UserId" asp-items="ViewBag.Users" class="form-select form-select-lg">
                            <option value="">-- Select User Account --</option>
                        </select>
                        <span asp-validation-for="UserId" class="text-danger"></span>
                        <div class="form-text mt-1">
                            Don't see the user? <a asp-controller="Account" asp-action="AddUser" class="text-primary fw-bold">Create User Account here</a> first.
                        </div>
                    </div>

                    <div class="d-flex align-items-center justify-content-between mt-4">
                        <a class="btn btn-secondary" asp-controller="Employee" asp-action="Index">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">Save Employee</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
