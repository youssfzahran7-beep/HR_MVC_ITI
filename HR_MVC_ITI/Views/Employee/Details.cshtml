@model HR_MVC_ITI.Models.Enitityes.Employee

@{
    ViewData["Title"] = "Employee details";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-1">Employee details</h1>
        <p class="text-muted mb-0">Profile information for @Model.FullName.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-2"></i>Back to employees</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <dl class="row mb-0">
            <dt class="col-sm-3 text-muted">Full name</dt>
            <dd class="col-sm-9">@Model.FullName</dd>
            <dt class="col-sm-3 text-muted">National ID</dt>
            <dd class="col-sm-9">@Model.NationalId</dd>
            <dt class="col-sm-3 text-muted">Linked user account</dt>
            <dd class="col-sm-9 font-monospace small">@Model.UserId</dd>
        </dl>
    </div>
    <div class="card-footer bg-white border-0 pt-0 pb-4 px-4">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="fas fa-pen me-2"></i>Edit employee</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger ms-2"><i class="fas fa-trash me-2"></i>Delete</a>
    </div>
</div>
