@model IEnumerable<HR_MVC_ITI.Models.Enitityes.Candidate>

@{
    ViewData["Title"] = "Candidates";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mt-4">Candidates</h1>
        <p class="text-muted">Manage candidate profiles</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-user-plus me-1"></i>
        Add Candidate
    </a>
</div>

<div class="card mb-4">
    <div class="card-header">
        <i class="fas fa-users me-1"></i>
        Candidate Profiles
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover">
                <thead>
                    <tr>
                        <th>First Name</th>
                        <th>Last Name</th>
                        <th>Phone</th>
                        <th>Resume</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null)
                    {
                        foreach (var candidate in Model)
                        {
                            <tr>
                                <td>@candidate.FirstName</td>
                                <td>@candidate.LastName</td>
                                <td>@candidate.Phone</td>

                                <td>
                                    @if (!string.IsNullOrEmpty(candidate.ResumeFilePath))
                                    {
                                        <a href="@candidate.ResumeFilePath"
                                           target="_blank"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-file-pdf"></i>
                                            View Resume
                                        </a>
                                    }
                                </td>

                                <td>
                                    <a asp-action="Details"
                                       asp-route-id="@candidate.Id"
                                       class="btn btn-sm btn-info">
                                        Details
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@candidate.Id"
                                       class="btn btn-sm btn-warning">
                                        Edit
                                    </a>

                                    <form asp-action="Delete"
                                          asp-route-id="@candidate.Id"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Are you sure you want to delete this candidate?');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-danger">
                                            Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
