@model HR_MVC_ITI.Models.Enitityes.Candidate

@{
    ViewData["Title"] = "Candidate Details";
}

<h1 class="mt-4">Candidate Details</h1>

<div class="card mb-4">
    <div class="card-header">
        <i class="fas fa-user me-1"></i>
        Candidate Profile
    </div>

    <div class="card-body">

        <dl class="row">

            <dt class="col-sm-3">
                First Name
            </dt>
            <dd class="col-sm-9">
                @Model.FirstName
            </dd>

            <dt class="col-sm-3">
                Last Name
            </dt>
            <dd class="col-sm-9">
                @Model.LastName
            </dd>

            <dt class="col-sm-3">
                Phone
            </dt>
            <dd class="col-sm-9">
                @Model.Phone
            </dd>

            <dt class="col-sm-3">
                User ID
            </dt>
            <dd class="col-sm-9">
                @Model.UserId
            </dd>

            <dt class="col-sm-3">
                Resume
            </dt>
            <dd class="col-sm-9">
                @if (!string.IsNullOrEmpty(Model.ResumeFilePath))
                {
                    <a href="@Model.ResumeFilePath"
                       target="_blank"
                       class="btn btn-outline-primary">
                        <i class="fas fa-file-alt me-1"></i>
                        View Resume
                    </a>
                }
            </dd>

        </dl>

        <div class="mt-3">
            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-warning">
                <i class="fas fa-edit me-1"></i>
                Edit
            </a>

            <a asp-action="Index"
               class="btn btn-secondary">
                Back
            </a>
        </div>

    </div>
</div>
