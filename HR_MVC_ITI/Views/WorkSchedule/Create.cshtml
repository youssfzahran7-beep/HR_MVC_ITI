@model HR_MVC_ITI.Models.ViewModels.WorkScheduleViewModel

@{
    ViewData["Title"] = "Create Work Schedule";
}

<h1 class="mt-4">Create Work Schedule</h1>
<ol class="breadcrumb mb-4">
    <li class="breadcrumb-item"><a asp-action="Index">Work Schedules</a></li>
    <li class="breadcrumb-item active">Create</li>
</ol>

<div class="card mb-4">
    <div class="card-header">
        <i class="fas fa-plus me-1"></i>New Schedule
    </div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="CheckInTime" class="form-label"></label>
                    <input asp-for="CheckInTime" class="form-control" type="time" />
                    <span asp-validation-for="CheckInTime" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="CheckOutTime" class="form-label"></label>
                    <input asp-for="CheckOutTime" class="form-control" type="time" />
                    <span asp-validation-for="CheckOutTime" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label">Active</label>
            </div>

            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save me-1"></i>Save
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-1"></i>Back
            </a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
