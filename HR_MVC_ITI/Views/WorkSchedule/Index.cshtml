@model List<HR_MVC_ITI.Models.ViewModels.WorkScheduleViewModel>

@{
    ViewData["Title"] = "Work Schedules";
}

<h1 class="mt-4">Work Schedules</h1>
<ol class="breadcrumb mb-4">
    <li class="breadcrumb-item active">Manage work schedule settings</li>
</ol>

<a asp-action="Create" class="btn btn-primary mb-3">
    <i class="fas fa-plus me-1"></i>Add New Schedule
</a>

<div class="card mb-4">
    <div class="card-header">
        <i class="fas fa-clock me-1"></i>All Schedules
    </div>
    <div class="card-body">
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Check In Time</th>
                    <th>Check Out Time</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var schedule in Model)
                    {
                        <tr>
                            <td>@schedule.Id</td>
                            <td>@schedule.CheckInTime.ToString(@"hh\:mm")</td>
                            <td>@schedule.CheckOutTime.ToString(@"hh\:mm")</td>
                            <td>
                                @if (schedule.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@schedule.Id" class="btn btn-sm btn-warning">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@schedule.Id" class="btn btn-sm btn-danger"
                                   onclick="return confirm('Are you sure you want to delete this schedule?')">
                                    <i class="fas fa-trash"></i> Delete
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center">No schedules found. Please create one.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
